# Copia este ficheiro para .env (o .env nunca vai para o git).
# Os nomes começam por OPENAI_ porque usamos o SDK openai; a API é a do Gemini (compatível).

# Chave da API do Gemini (Google AI Studio). Vazia = modo mock (respostas pré-escritas, dá para
# trabalhar sem chave). A chave é pessoal: não a partilhes nem a escrevas em ficheiros do repo.
OPENAI_API_KEY=

# Endpoint compatível com OpenAI do Gemini.
# Plano B: z.ai (https://api.z.ai/api/coding/paas/v4, OPENAI_MODEL=glm-5.3, chave da z.ai; o
# Coding Plan só é permitido em ferramentas suportadas) ou OpenAI (https://api.openai.com/v1).
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Se a API responder 402 "prepayment credits are depleted", o projeto não tem créditos: ativa a
# faturação no AI Studio (https://ai.studio/projects) ou usa o modo mock (chave vazia).
#
# Modelo principal. Medido em 2026-10-27 com uma chave do plano gratuito: gemini-3.6-flash ~3 s,
# gemini-3.5-flash ~7 s, gemini-3.5-flash-lite ~10 s (o 2.5 dá 404; o 3.1-flash-lite dá 503).
# O gemini-3-flash-preview é o mais rápido (1 a 3 s), mas só deixa 20 pedidos por dia no plano
# gratuito. Cada modelo tem a sua quota pequena: um percurso completo da app gasta 10 a 15 pedidos.
OPENAI_MODEL=gemini-3.6-flash

# Alternativas, por ordem (máx. 3 modelos no total), quando o principal dá 429 (quota), 503 ou
# fica lento (10 s por tentativa). O log do servidor diz qual respondeu.
OPENAI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# Esforço de raciocínio: minimal · low · medium · high. Vazio = o valor por omissão da API.
OPENAI_REASONING_EFFORT=low

# Fixa a "semana atual" para a demo (a W44 é a 4.ª semana da Inês).
DEMO_SEMANA=2026-W44

# ---------------------------------------------------------------------------
# ALTERNATIVA PRONTA: z.ai (GLM). Para trocar: comenta as 3 linhas do bloco
# Gemini (KEY, BASE_URL, MODEL) e descomenta as 3 seguintes; reinicia o servidor.
# O OPENAI_REASONING_EFFORT=low fica como está, serve para os dois.
# Nota: a chave do Coding Plan é reservada para ferramentas de código; se a z.ai
# a recusar na app, usa a API geral (OPENAI_BASE_URL=https://api.z.ai/api/paas/v4
# com uma chave dessa API).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# OPENAI_MODEL=glm-5.3
