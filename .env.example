# Copia este ficheiro para .env (o .env nunca vai para o git).

# Chave da OpenAI. Vazia = modo mock (respostas pré-escritas, dá para trabalhar sem chave).
OPENAI_API_KEY=

# Modelo a usar. Confirmem na vossa conta OpenAI que modelo está disponível.
OPENAI_MODEL=gpt-5-mini

# Fixa a "semana atual" para a demo (a W44 é a 4.ª semana da Inês).
DEMO_SEMANA=2026-W44
