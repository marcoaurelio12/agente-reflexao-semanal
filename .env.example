# Copia este ficheiro para .env (o .env nunca vai para o git).
# Os nomes começam por OPENAI_ porque usamos o SDK openai; a API é a da z.ai (compatível).

# Chave do GLM Coding Plan da z.ai. Vazia = modo mock (respostas pré-escritas, dá para trabalhar sem chave).
# Não partilhes esta chave: é pessoal, e a z.ai trata a partilha de conta como infração.
OPENAI_API_KEY=

# Endpoint do Coding Plan. Plano B: API geral da z.ai (https://api.z.ai/api/paas/v4, outra chave)
# ou OpenAI (https://api.openai.com/v1, com OPENAI_MODEL=gpt-5-mini).
OPENAI_BASE_URL=https://api.z.ai/api/coding/paas/v4

# Modelo: glm-5.3 ou glm-5.3-flash.
OPENAI_MODEL=glm-5.3

# O GLM-5.3 pensa sempre antes de responder; por omissão pensa ao máximo e fica lento.
# minimal · low · medium · high · max. Vazio = o valor por omissão da API.
OPENAI_REASONING_EFFORT=low

# Fixa a "semana atual" para a demo (a W44 é a 4.ª semana da Inês).
DEMO_SEMANA=2026-W44
